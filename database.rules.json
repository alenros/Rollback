{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)"
      }
    },
    "telemetry": {
      "games": {
        "$gameId": {
          "events": {
            "$eventId": {
              ".write": "!data.exists()",
              ".validate": "newData.hasChildren(['type', 'gameId', 'seq', 'at']) && newData.child('gameId').val() === $gameId && newData.child('at').val() === now"
            }
          }
        }
      }
    }
  }
}
