---
// Static die for server-rendered pages; shares its markup with the game UI.
import type { Color, Sides } from '../lib/dice';
import { dieHtml } from '../lib/game-ui';

export interface Props {
    color: Color;
    sides: Sides;
    value: number;
}
const { color, sides, value } = Astro.props;
---

<Fragment set:html={dieHtml({ id: `static-${color}-d${sides}`, color, sides, value })} />
