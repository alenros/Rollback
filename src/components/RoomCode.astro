---
export interface Props {
    codeId?: string;
}

const { codeId = "display-room-code" } = Astro.props;
---

<section class="panel ticket" aria-label="Room code">
    <span class="label">Room code</span>
    <div class="code" id={codeId}></div>
    <p class="hint">Share it with 1–4 friends.</p>
</section>
