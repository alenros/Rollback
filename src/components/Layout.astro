---
import '@fontsource/bowlby-one/400.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/600.css';
import '../styles/styles.css';
import '../styles/themes.css';
import ThemeSwitcher from './ThemeSwitcher.astro';
import { THEMES, THEME_KEY } from '../lib/theme';

export interface Props {
    title?: string;
    /** The home page is the box cover: its own big title, no header strip. */
    cover?: boolean;
}

const { title = "Rollback - Dice Climbing Game", cover = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{title}</title>
    <!-- Apply the trial theme before first paint: ?theme= wins and is remembered, else the saved choice. -->
    <script is:inline define:vars={{ themes: THEMES, key: THEME_KEY }}>
        const fromUrl = new URLSearchParams(location.search).get('theme');
        let theme = themes.includes(fromUrl) ? fromUrl : null;
        try {
            if (theme) localStorage.setItem(key, theme);
            else if (themes.includes(localStorage.getItem(key))) theme = localStorage.getItem(key);
        } catch { /* storage blocked: URL choice still applies */ }
        if (theme && theme !== 'box-art') document.documentElement.dataset.theme = theme;
    </script>
</head>
<body>
    <div class="shell">
        {!cover && (
            <header class="topbar">
                <a class="wordmark" href={baseUrl}>Rollback</a>
                <div class="topbar-slot"><slot name="header" /></div>
            </header>
        )}
        <main>
            <slot />
        </main>
        <div id="message-area" role="status" aria-live="polite"></div>
    </div>
    <ThemeSwitcher />
</body>
</html>
