---
import '@fontsource/bowlby-one/400.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/600.css';
import '../styles/styles.css';

export interface Props {
    title?: string;
    /** The home page is the box cover: its own big title, no header strip. */
    cover?: boolean;
}

const { title = "Rollback - Dice Climbing Game", cover = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{title}</title>
    <!-- Apply the player's die-face choice (pips or numbers) before first paint; the game page's toggle writes it. -->
    <script is:inline>
        try { if (localStorage.getItem('rollbackFaces') === 'numbers') document.documentElement.dataset.dieFaces = 'numbers'; } catch {}
    </script>
</head>
<body>
    <div class="shell">
        {!cover && (
            <header class="topbar">
                <a class="wordmark" href={baseUrl}>Rollback</a>
                <div class="topbar-slot"><slot name="header" /></div>
            </header>
        )}
        <main>
            <slot />
        </main>
        <div id="message-area" role="status" aria-live="polite"></div>
    </div>
</body>
</html>
