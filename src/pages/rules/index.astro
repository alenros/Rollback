---
import Layout from '../../components/Layout.astro';
import { rulesetList } from '../../lib/rulesets';

const baseUrl = import.meta.env.BASE_URL;
const rulesets = rulesetList();
---

<Layout title="Rollback - Rules">
    <span slot="header" class="tag">Rulebook</span>
    <div class="rules-index">
        <h2>How to play</h2>
        <p class="hint">The host picks the rules in the lobby.</p>
        {rulesets.map(r => (
            <a class="ruleset-card" href={`${baseUrl}rules/${r.id}`}>
                <strong>{r.name}</strong>
                <span>{r.summary}</span>
            </a>
        ))}
    </div>
</Layout>
