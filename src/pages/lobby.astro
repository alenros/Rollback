---
import Layout from '../components/Layout.astro';
import RoomCode from '../components/RoomCode.astro';
import PlayerList from '../components/PlayerList.astro';
import { rulesetList } from '../lib/rulesets';

const rulesets = rulesetList();
---

<Layout title="Rollback - Lobby">
    <span slot="header" class="tag">Waiting room</span>
    <div class="lobby">
        <div class="lobby-col">
            <RoomCode />
            <PlayerList containerId="players-container" title="Players" />
        </div>
        <div class="lobby-col">
            <section class="panel ruleset-picker">
                <h3><label for="ruleset-select">Rules</label></h3>
                <select id="ruleset-select" disabled>
                    {rulesets.map(r => <option value={r.id}>{r.name}</option>)}
                </select>
                <p id="ruleset-summary" class="hint"></p>
                <p id="lobby-hint" class="hint"></p>
                <div class="button-row">
                    <button id="start-game-btn" class="primary" style="display: none;">Start game</button>
                    <button id="leave-room-btn">Leave room</button>
                </div>
            </section>
        </div>
    </div>
</Layout>

<script>
    import { GameError } from '../lib/game';
    import { getRuleset, type RulesetId } from '../lib/rulesets';
    import { GameStatus } from '../lib/game-status';
    import { playersInOrder } from '../lib/room';
    import { clearSession, escapeHtml, getCurrentPlayer, getRoomCodeFromUrl } from '../lib/session';

    const BASE_URL = import.meta.env.BASE_URL;

    document.addEventListener('DOMContentLoaded', async () => {
        const roomCode = getRoomCodeFromUrl();
        const currentPlayer = getCurrentPlayer();
        if (!roomCode || !currentPlayer) {
            alert(!roomCode ? 'No room code provided' : 'No player data found');
            window.location.href = BASE_URL;
            return;
        }

        const roomCodeDisplay = document.getElementById('display-room-code');
        if (roomCodeDisplay) roomCodeDisplay.textContent = roomCode;

        const { watchRoom, startRoomGame, leaveRoom, setRoomRuleset } = await import('../lib/room-actions');
        const rulesetSelect = document.getElementById('ruleset-select') as HTMLSelectElement;
        const rulesetSummary = document.getElementById('ruleset-summary') as HTMLElement;
        const startBtn = document.getElementById('start-game-btn') as HTMLButtonElement;
        const hint = document.getElementById('lobby-hint') as HTMLElement;

        const unwatch = watchRoom(roomCode, room => {
            if (!room) {
                alert('Room no longer exists');
                window.location.href = BASE_URL;
                return;
            }
            if (!room.players?.[currentPlayer.id]) {
                alert('You are no longer in this room');
                clearSession();
                window.location.href = BASE_URL;
                return;
            }
            if (room.status !== GameStatus.WAITING) {
                window.location.href = `${BASE_URL}game?code=${roomCode}`;
                return;
            }

            const players = playersInOrder(room);
            const container = document.getElementById('players-container');
            if (container) {
                container.innerHTML = players.map(p => `
                    <div class="player">
                        <span class="player-name">${escapeHtml(p.name)}${p.id === currentPlayer.id ? ' (you)' : ''}</span>
                        ${p.isHost ? '<span class="player-status">Host</span>' : ''}
                    </div>`).join('');
            }

            const isHost = room.hostId === currentPlayer.id;
            const rules = getRuleset(room.rulesetId);
            rulesetSelect.value = rules.id;
            rulesetSelect.disabled = !isHost;
            rulesetSummary.innerHTML = `${escapeHtml(rules.summary)} <a href="${BASE_URL}rules/${rules.id}">Full rules</a>`;

            const enough = players.length >= rules.minPlayers;
            startBtn.style.display = isHost && enough ? 'inline-block' : 'none';
            hint.textContent = !enough
                ? `Waiting for players… ${players.length}/${rules.minPlayers} needed (max ${rules.maxPlayers}).`
                : isHost ? 'Ready when you are. Seating follows join order.' : 'Waiting for the host to start.';
        });

        rulesetSelect.addEventListener('change', async () => {
            try {
                await setRoomRuleset(roomCode, currentPlayer.id, rulesetSelect.value as RulesetId);
            } catch (error) {
                console.error('Error choosing rules:', error);
                alert(error instanceof GameError ? error.message : 'Failed to change the rules');
            }
        });

        startBtn.addEventListener('click', async () => {
            startBtn.disabled = true;
            try {
                await startRoomGame(roomCode, currentPlayer.id);
            } catch (error) {
                console.error('Error starting game:', error);
                alert(error instanceof GameError ? error.message : 'Failed to start game');
                startBtn.disabled = false;
            }
        });

        document.getElementById('leave-room-btn')?.addEventListener('click', async () => {
            try {
                unwatch();
                await leaveRoom(roomCode, currentPlayer.id);
                clearSession();
                window.location.href = BASE_URL;
            } catch (error) {
                console.error('Error leaving room:', error);
                alert('Failed to leave room');
            }
        });
    });
</script>
